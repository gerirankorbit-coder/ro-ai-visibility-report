# All of these are SERVER-ONLY. None of them is sent to the browser (no VITE_ prefix).
# Put them in .env.local for `npm run dev`, and in Vercel -> Settings -> Environment Variables.

# The one password that unlocks the whole site. At least 12 characters. Use a long passphrase.
SITE_PASSWORD=
# Random signing secret, at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
# Hours a sign-in lasts before the password is asked again (default 12).
SESSION_HOURS=12

# Supabase (Project Settings -> API). Use the service_role / secret key, never commit it.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
